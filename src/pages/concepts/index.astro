---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const concepts = (await getCollection('concepts')).sort(
  (a, b) => a.data.week - b.data.week || a.data.order - b.data.order,
);
---
<Base title="Notes · Rohan Divekar">
  <div class="wrap">
    <section style="padding-top: 32px">
      <div class="section-head">
        <h1 style="font-size: clamp(2.4rem, 5vw, 3.5rem)">Notes</h1>
        <p>One note per concept, in the order I build them. A note goes live only with a demo, at least two numbers and the code behind them.</p>
      </div>
      <ul class="notes">
        {concepts.map((c) => (
          <li>
            <a href={`/concepts/${c.id}/`}>
              <span class="wk">{c.data.week === 0 ? 'Ready now' : `Week ${c.data.week}`}</span>
              <div><h3>{c.data.title}</h3><p>{c.data.claim}</p></div>
              <span class:list={['state', { live: c.data.status === 'live' }]}>{c.data.status === 'live' ? 'Live' : c.data.status === 'in-progress' ? 'In progress' : 'Planned'}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
