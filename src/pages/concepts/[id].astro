---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map((concept) => ({ params: { id: concept.id }, props: { concept } }));
}

const { concept } = Astro.props;
const c = concept.data;
const { Content } = await render(concept);
---
<Base title={`${c.title} · Rohan`} description={c.claim}>
  <p><a href="/concepts/">← All concepts</a></p>
  <span class:list={['badge', { live: c.status === 'live' }]}>Month {c.month} · {c.status}</span>
  <h1>{c.title}</h1>
  <p>{c.claim}</p>

  <div class="demo">
    {!c.demo.src && <span class="muted">Demo pending ({c.demo.type})</span>}
    {c.demo.src && (c.demo.type === 'plot' || c.demo.type === 'animation') && <img src={c.demo.src} alt={c.demo.alt} />}
    {c.demo.src && c.demo.type === 'video' && <video src={c.demo.src} controls muted loop playsinline aria-label={c.demo.alt}></video>}
    {c.demo.src && c.demo.type === 'live' && <iframe src={c.demo.src} title={c.demo.alt} loading="lazy"></iframe>}
  </div>

  {c.metrics.length > 0 && (
    <div class="metrics">
      {c.metrics.map((m) => (
        <div class="metric"><div class="value">{m.value}</div><div class="label">{m.label}</div></div>
      ))}
    </div>
  )}

  <dl>
    <dt>Shows</dt><dd>{c.shows}</dd>
    <dt>Doesn't show</dt><dd>{c.limits}</dd>
    {c.code && <><dt>Code</dt><dd><a href={c.code}>{c.code}</a></dd></>}
    {c.derivation && <><dt>Derivation</dt><dd><a href={c.derivation}>{c.derivation}</a></dd></>}
  </dl>

  <Content />
</Base>
