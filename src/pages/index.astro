---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.month - b.data.month);
const concepts = await getCollection('concepts');
const liveConcepts = concepts.filter((c) => c.data.status === 'live').length;
---
<Base title="Rohan · ML control for Physical AI">
  <h1>Controls engineer, building ML-based planning and control for autonomous vehicles and Physical AI</h1>
  <p>
    13+ years building safety-critical control for autonomous vehicles: MPC, embedded real-time C++ and
    functional safety. Now building the learning side of the driving stack: imitation-learned and RL planners,
    learned vs model-based tracking, and validation layers for learned planning, then carrying the same pattern
    over to humanoid robots. Every claim on this site links to code and reproducible numbers.
  </p>

  <h2>Projects</h2>
  <div class="grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>

  <h2>Concepts</h2>
  <p>
    {liveConcepts} of {concepts.length} concept demos live. Each one is a simulation, animation or plot with the
    numbers behind it. <a href="/concepts/">See all concepts</a>.
  </p>
</Base>
